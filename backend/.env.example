# AI Provider 설정
# 프론트엔드에는 절대 API Key를 넣지 마세요. FastAPI 백엔드에서만 사용합니다.
AI_PROVIDER=gemini

# Gemini API 설정
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60

# NVIDIA NIM 설정
# AI_PROVIDER=nvidia일 때만 사용합니다.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_TIMEOUT_SECONDS=60

# Phase 6 외부 기준 검색 어댑터 설정
# 실제 API 계약 확정 전에는 비워두면 샘플 fallback으로 동작합니다.
LAW_API_BASE_URL=
LAW_API_KEY=
KCSC_API_BASE_URL=https://kcsc.re.kr/OpenApi
KCSC_API_KEY=
KCSC_FETCH_VIEWER_ON_SEARCH=false
EXTERNAL_TIMEOUT_SECONDS=20

# 운영/관리 설정
ADMIN_TOKEN=
BACKUP_RETENTION_COUNT=20
